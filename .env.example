# DataForSEO: app.dataforseo.com/api-access (API password is NOT your account password)
DATAFORSEO_LOGIN=
DATAFORSEO_PASSWORD=
# 2840 = United States, 2826 = United Kingdom, 2036 = Australia, 2124 = Canada
LOCATION_CODE=2840
LANGUAGE_CODE=en

# WordPress: Users > Profile > Application Passwords
WP_URL=https://yoursite.com
WP_USER=
WP_APP_PASSWORD=
# draft (you publish by hand), future (scheduled), or publish (live right away)
WP_STATUS=draft
